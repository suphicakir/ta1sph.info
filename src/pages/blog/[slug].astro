---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Sidebar from '../../components/Sidebar.astro';
import Footer from '../../components/Footer.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const yazilar = await getCollection('blog');
  return yazilar.map((yazi) => ({
    params: { slug: yazi.id },
    props: { yazi },
  }));
}

const { yazi } = Astro.props;
const { Content } = await render(yazi);

const ogGorsel = yazi.data.kapakGorseli ?? '/assets/img/og-image.jpg';
---

<BaseLayout
  title={yazi.data.baslik}
  description={yazi.data.ozet}
  ogGorsel={ogGorsel}
  ogTip="article"
  kanonikalUrl={`https://ta1sph.info/blog/${yazi.id}`}
>