---
// src/pages/index.astro
import BaseLayout from '../layouts/BaseLayout.astro';
import Sidebar from '../components/Sidebar.astro';
import Hero from '../components/Hero.astro';
import About from '../components/About.astro';
import Services from '../components/Services.astro';
import Callout from '../components/Callout.astro';
import Portfolio from '../components/Portfolio.astro';
import CallToAction from '../components/CallToAction.astro';
import Contact from '../components/Contact.astro';
import Footer from '../components/Footer.astro';
---

<BaseLayout
  title="TA1SPH | Suphi Ç."
  description="Full Stack Developer kişisel portfolyo ve blog sitesi"
>

  <Sidebar sayfaTipi="ana" />

  <Hero
    baslik="Merhaba, Ben TA1SPH"
    altBaslik="QTH İstanbul, Gaziosmanpaşa @ Locater : KN41KB"
    butonYazi="QRV @ 28690 73!"
    butonHedef="#about"
  />

  <About
  baslik="Hakkımda"
  aciklama="Merhaba! Ben Suphi Çakır (TA1SPH). İstanbul, Gaziosmanpaşa'dan aktif bir amatör radyocuyum. DMR, VHF/UHF analog ve dijital modlarda çevrim yapıyorum. Amatör Radyocular Derneği (ARC | YM1KTC) üyesiyim ve radio.org.tr'de makaleler yazıyorum. Locator: KN41KB · DMR ID: 2866151"
  butonYazi="Ekipmanlarım"
  butonHedef="#services"
/>

  <Services
  ustBaslik="Ekipmanlar"
  anaBaslik="Kullandığım Cihazlar"
  hizmetler={[
    {
      ikon: 'icon-screen-smartphone',
      baslik: 'Tekser UV99',
      aciklama: 'UHF & VHF Analog El Telsizi',
    },
    {
      ikon: 'icon-screen-smartphone',
      baslik: 'Baofeng UV K5-Plus',
      aciklama: 'UHF & VHF Analog El Telsizi',
    },
    {
      ikon: 'icon-screen-smartphone',
      baslik: 'Anytone AT-D878UVII Plus',
      aciklama: 'Dijital & Analog VHF/UHF El Telsizi',
    },
    {
      ikon: 'icon-screen-desktop',
      baslik: 'Retevis RT95',
      aciklama: 'UHF & VHF Analog Mobil Telsiz',
    },
    {
      ikon: 'icon-screen-desktop',
      baslik: 'Anytone AT-D578UV Plus',
      aciklama: 'Dijital & Analog Dual Band Araç Telsizi',
    },
    {
      ikon: 'icon-feed',
      baslik: 'Diamond X30',
      aciklama: 'Çatı Anteni · VHF/UHF',
    },
    {
      ikon: 'icon-feed',
      baslik: 'Flower Pot Anten',
      aciklama: 'Omni-Directional · VHF/UHF',
    },
    {
      ikon: 'icon-feed',
      baslik: 'Moxon UHF Anten',
      aciklama: 'Yönlü · UHF Band',
    },
    {
      ikon: 'icon-feed',
      baslik: 'Ground Plane Anten',
      aciklama: 'Dikey Polarize · UHF Band',
    },
  ]}
/>

  <Callout
  baslik="Amatör Radyo tutkusu"
  vurguKelime="hayat boyu sürer!"
  butonYazi="İletişime Geç"
  butonLink="#contact"
/>

 <!-- ! Portfolio -->
  <Portfolio
  ustBaslik="Portfolyo"
  anaBaslik="Projeler & Etkinlikler"
  projeler={[
    {
      gorsel: '/assets/img/portfolio-1.jpg',
      baslik: 'DMR Ağı',
      aciklama: 'TG28690 üzerinden ARC çevrimi ve DMR dijital mod deneyimleri.',
      link: 'https://dmr.radio.org.tr',
    },
    {
      gorsel: '/assets/img/portfolio-2.jpg',
      baslik: 'Anten Projeleri',
      aciklama: 'Flower pot, Moxon ve Ground plane anten yapım & kurulum çalışmaları.',
      link: '#!',
    },
    {
      gorsel: '/assets/img/portfolio-3.jpg',
      baslik: 'ARC Üyeliği',
      aciklama: 'Amatör Radyocular Derneği etkinlikleri, eğitimler ve teknik projeler.',
      link: 'https://radio.org.tr',
    },
    {
      gorsel: '/assets/img/portfolio-4.jpg',
      baslik: 'Makaleler',
      aciklama: 'radio.org.tr\'de yayımlanan amatör telsizcilik ve teknik içerikler.',
      link: 'https://radio.org.tr/blog',
    },
  ]}
/>

  <CallToAction
    baslik="Bir projen mi var? Konuşalım!"
    butonlar={[
      {
        yazi: 'CV İndir',
        link: '/cv.pdf',
        stil: 'light',
      },
      {
        yazi: 'İletişime Geç',
        link: '#contact',
        stil: 'dark',
      },
    ]}
  />

  <Contact
    haritaUrl="https://maps.google.com/maps?f=q&source=s_q&hl=tr&q=Istanbul,+Turkey&ie=UTF8&t=m&z=13&output=embed"
    haritaBaslik="İstanbul Konumu"
  />

  <Footer
  telif={`Copyright © ${new Date().getFullYear()} TA1SPH — Suphi Çakır`}
  sosyalLinkler={[
    {
      ikon: 'icon-social-github',
      link: 'https://github.com/ta1sph',
      baslik: 'GitHub',
    },
    {
      ikon: 'icon-social-linkedin',
      link: 'https://linkedin.com/in/suphicakir',
      baslik: 'LinkedIn',
    },
    {
      ikon: 'icon-social-twitter',
      link: 'https://twitter.com/ta1sph',
      baslik: 'Twitter',
    },
  ]}
/>

</BaseLayout>