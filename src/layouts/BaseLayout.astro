---
// src/layouts/BaseLayout.astro
interface Props {
  title?: string;
  description?: string;
  ogGorsel?: string;
  ogTip?: string;
  kanonikalUrl?: string;
}

const {
  title = 'TA1SPH | Suphi Çakır — Amatör Radyo',
  description = 'TA1SPH — Suphi Çakır. İstanbul, Gaziosmanpaşa. DMR ID: 2866151. Locator: KN41KB. Amatör Radyocular Derneği (ARC | YM1KTC) üyesi.',
  ogGorsel = '/assets/img/og-image.jpg',
  ogTip = 'website',
  kanonikalUrl = Astro.url.href,
} = Astro.props;

const sitUrl = 'https://ta1sph.info';
const tamBaslik = title.includes('TA1SPH') ? title : `${title} | TA1SPH`;
---

<!DOCTYPE html>
<html lang="tr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no" />

    <!-- Temel SEO -->
    <title>{tamBaslik}</title>
    <meta name="description" content={description} />
    <meta name="author" content="Suphi Çakır — TA1SPH" />
    <meta name="keywords" content="TA1SPH, amatör radyo, telsiz, DMR, İstanbul, KN41KB, ARC, YM1KTC, 28690" />
    <link rel="canonical" href={kanonikalUrl} />

    <!-- Open Graph -->
    <meta property="og:type" content={ogTip} />
    <meta property="og:url" content={kanonikalUrl} />
    <meta property="og:title" content={tamBaslik} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={`${sitUrl}${ogGorsel}`} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:site_name" content="TA1SPH" />
    <meta property="og:locale" content="tr_TR" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={kanonikalUrl} />
    <meta name="twitter:title" content={tamBaslik} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={`${sitUrl}${ogGorsel}`} />

    <!-- Favicon -->
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />

    <!-- Font Awesome -->
    <script is:inline src="https://use.fontawesome.com/releases/v6.3.0/js/all.js" crossorigin="anonymous"></script>

    <!-- Simple Line Icons -->
    <link
      href="https://cdnjs.cloudflare.com/ajax/libs/simple-line-icons/2.5.5/css/simple-line-icons.min.css"
      rel="stylesheet"
    />

    <!-- Google Fonts -->
    <link
      href="https://fonts.googleapis.com/css?family=Source+Sans+Pro:300,400,700,300italic,400italic,700italic"
      rel="stylesheet"
      type="text/css"
    />

    <!-- Bootstrap -->
    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.2.3/dist/css/bootstrap.min.css"
      rel="stylesheet"
    />

    <!-- Template CSS -->
    <link href="/css/styles.css" rel="stylesheet" />
  </head>

  <body id="page-top">
    <slot />

    <!-- Bootstrap JS -->
    <script is:inline src="https://cdn.jsdelivr.net/npm/bootstrap@5.2.3/dist/js/bootstrap.bundle.min.js"></script>

    <!-- Template JS -->
    <script is:inline src="/js/scripts.js"></script>
  </body>
</html>