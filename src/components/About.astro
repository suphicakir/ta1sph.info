---
// src/components/About.astro
interface Props {
  baslik?: string;
  aciklama?: string;
  butonYazi?: string;
  butonHedef?: string;
}

const {
  baslik = 'Hakkımda',
  aciklama = 'Merhaba! Ben bir Full Stack Developer\'ım. Web teknolojileri, açık kaynak yazılımlar ve modern geliştirme araçlarına olan tutkumla projeler üretiyorum.',
  butonYazi = 'Neler Yapıyorum?',
  butonHedef = '#services',
} = Astro.props;
---

<section class="content-section bg-light" id="about">
  <div class="container px-4 px-lg-5 text-center">
    <div class="row gx-4 gx-lg-5 justify-content-center">
      <div class="col-lg-10">
        <h2>{baslik}</h2>
        <p class="lead mb-5">{aciklama}</p>
        <a class="btn btn-dark btn-xl js-scroll-trigger" href={butonHedef}>
          {butonYazi}
        </a>
      </div>
    </div>
  </div>
</section>