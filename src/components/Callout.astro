---
// src/components/Callout.astro
interface Props {
  baslik?: string;
  vurguKelime?: string;
  butonYazi?: string;
  butonLink?: string;
}

const {
  baslik = 'Amatör Radyo tutkusu',
  vurguKelime = 'hayat boyu sürer!',
  butonYazi = 'İletişime Geç',
  butonLink = '#contact',
} = Astro.props;
---

<section class="callout">
  <div class="container px-4 px-lg-5 text-center">

    <!-- CQ çağrısı -->
    <p class="text-warning fw-bold mb-2" style="font-family: monospace; font-size: 1.1rem; letter-spacing: 2px;">
      CQ CQ CQ — 73 DE TA1SPH
    </p>

    <h2 class="mx-auto mb-4 text-white">
      {baslik} <em class="text-warning">{vurguKelime}</em>
    </h2>

    <!-- Frekans bilgisi -->
    <div class="d-flex justify-content-center gap-3 flex-wrap mb-5">
      <span class="badge fs-6 px-3 py-2" style="background:rgba(255,255,255,0.15); border:1px solid rgba(255,255,255,0.3);">
        <i class="fas fa-broadcast-tower me-1 text-warning"></i> 439.200 MHz
      </span>
      <span class="badge fs-6 px-3 py-2" style="background:rgba(255,255,255,0.15); border:1px solid rgba(255,255,255,0.3);">
        <i class="fas fa-satellite-dish me-1 text-warning"></i>  433.500 MHz
      </span>
      <span class="badge fs-6 px-3 py-2" style="background:rgba(255,255,255,0.15); border:1px solid rgba(255,255,255,0.3);">
        <i class="fas fa-globe me-1 text-warning"></i> DMR TG 28690
      </span>
    </div>

    <a class="btn btn-warning btn-xl js-scroll-trigger fw-bold" href={butonLink}>
      {butonYazi}
    </a>

  </div>
</section>

<style>
  .callout {
    background-image: url('/assets/img/bg-callout.jpg');
    background-size: cover;
    background-position: center;
    position: relative;
    padding: 8rem 0;
  }

  .callout::before {
    content: '';
    position: absolute;
    inset: 0;
    background-color: rgba(10, 20, 60, 0.78);
    z-index: 0;
  }

  .callout .container {
    position: relative;
    z-index: 1;
  }
</style>