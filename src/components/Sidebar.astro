---
// src/components/Sidebar.astro
interface Props {
  sayfaTipi?: 'ana' | 'blog';
}

const { sayfaTipi = 'ana' } = Astro.props;
---

<!-- Menü Toggle Butonu -->
<a class="menu-toggle rounded" href="#"><i class="fas fa-bars"></i></a>

<!-- Sidebar -->
<nav id="sidebar-wrapper">
  <ul class="sidebar-nav">
    <li class="sidebar-brand">
      <a href="/">Portfolyo</a>
    </li>

    {sayfaTipi === 'ana' ? (
      <>
        <li class="sidebar-nav-item">
          <a class="js-scroll-trigger" href="#page-top">Ana Sayfa</a>
        </li>
        <li class="sidebar-nav-item">
          <a class="js-scroll-trigger" href="#about">Hakkımda</a>
        </li>
        <li class="sidebar-nav-item">
          <a class="js-scroll-trigger" href="#services">Hizmetler</a>
        </li>
        <li class="sidebar-nav-item">
          <a class="js-scroll-trigger" href="#portfolio">Portfolyo</a>
        </li>
        <li class="sidebar-nav-item">
          <a class="js-scroll-trigger" href="#contact">İletişim</a>
        </li>
        <li class="sidebar-nav-item">
          <a href="/blog">Blog</a>
        </li>
      </>
    ) : (
      <>
        <li class="sidebar-nav-item">
          <a href="/">Ana Sayfa</a>
        </li>
        <li class="sidebar-nav-item">
          <a href="/#about">Hakkımda</a>
        </li>
        <li class="sidebar-nav-item">
          <a href="/#portfolio">Portfolyo</a>
        </li>
        <li class="sidebar-nav-item">
          <a href="/blog" class="active">Blog</a>
        </li>
        <li class="sidebar-nav-item">
          <a href="/#contact">İletişim</a>
        </li>
      </>
    )}
  </ul>
</nav>