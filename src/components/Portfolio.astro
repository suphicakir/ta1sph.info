---
// src/components/Portfolio.astro
interface ProjeKart {
  gorsel: string;
  baslik: string;
  aciklama: string;
  link?: string;
}

interface Props {
  ustBaslik?: string;
  anaBaslik?: string;
  projeler?: ProjeKart[];
}

const {
  ustBaslik = 'Portfolyo',
  anaBaslik = 'Projeler & Etkinlikler',
  projeler = [],
} = Astro.props;
---

<section class="content-section" id="portfolio">
  <div class="container px-4 px-lg-5">

    <div class="content-section-heading text-center mb-5">
      <h3 class="text-secondary mb-0">{ustBaslik}</h3>
      <h2 class="mb-2">{anaBaslik}</h2>
      <p class="text-muted">Amatör radyo dünyasındaki çalışmalar ve katkılar</p>
    </div>

    <div class="row gx-0">
      {projeler.map((proje, index) => {
        const hedef = proje.link && proje.link !== '#!' ? '_blank' : '_self';
        const numara = String(index + 1).padStart(2, '0');
        const disTip = proje.link && proje.link !== '#!';
        return (
          <div class="col-lg-6">
            <a class="portfolio-item" href={proje.link ?? '#!'} target={hedef} rel="noopener noreferrer">
              <div class="caption">
                <div class="caption-content">
                  <div class="small text-warning mb-1" style="font-family:monospace; letter-spacing:1px;">QSO #{numara}</div>
                  <div class="h2">{proje.baslik}</div>
                  <p class="mb-0">{proje.aciklama}</p>
                  {disTip && (
                    <div class="mt-2 small"><i class="fas fa-external-link-alt me-1"></i> Ziyaret Et</div>
                  )}
                </div>
              </div>
              <img class="img-fluid" src={proje.gorsel} alt={proje.baslik} />
            </a>
          </div>
        );
      })}
    </div>

  </div>
</section>

<style>
  /* Overlay her zaman görünür — hover'da daha da belirgin */
  .portfolio-item .caption {
    background: rgba(10, 20, 60, 0.72);
    opacity: 1 !important;
  }

  .portfolio-item:hover .caption {
    background: rgba(10, 20, 60, 0.88);
  }

  /* Başlık ve metin renkleri */
  .portfolio-item .caption-content .h2 {
    color: #ffffff;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 1px;
    font-size: 1.4rem;
  }

  .portfolio-item .caption-content p {
    color: #e0e8f8;
    font-size: 0.95rem;
  }

  .portfolio-item .caption-content .small {
    color: #90caf9;
  }

  /* QSO numara */
  .qso-numara {
    font-family: monospace;
    letter-spacing: 2px;
    font-size: 0.8rem;
    color: #ffc107;
    font-weight: 700;
    margin-bottom: 0.4rem;
  }
</style>