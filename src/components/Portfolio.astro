---
// src/components/Portfolio.astro
interface ProjeKart {
  gorsel: string;
  baslik: string;
  aciklama: string;
  link?: string;
}

interface Props {
  ustBaslik?: string;
  anaBaslik?: string;
  projeler?: ProjeKart[];
}

const {
  ustBaslik = 'Portfolyo',
  anaBaslik = 'Son Projelerim',
  projeler = [
    {
      gorsel: '/assets/img/portfolio-1.jpg',
      baslik: 'Proje Bir',
      aciklama: 'Modern bir web uygulaması tasarımı ve geliştirmesi.',
      link: '#!',
    },
    {
      gorsel: '/assets/img/portfolio-2.jpg',
      baslik: 'Proje İki',
      aciklama: 'Responsive arayüz ve kullanıcı deneyimi odaklı proje.',
      link: '#!',
    },
    {
      gorsel: '/assets/img/portfolio-3.jpg',
      baslik: 'Proje Üç',
      aciklama: 'Full stack uygulama geliştirme ve deployment süreci.',
      link: '#!',
    },
    {
      gorsel: '/assets/img/portfolio-4.jpg',
      baslik: 'Proje Dört',
      aciklama: 'Açık kaynak katkısı ve teknik dokümantasyon çalışması.',
      link: '#!',
    },
  ],
} = Astro.props;
---

<section class="content-section" id="portfolio">
  <div class="container px-4 px-lg-5">

    <div class="content-section-heading text-center">
      <h3 class="text-secondary mb-0">{ustBaslik}</h3>
      <h2 class="mb-5">{anaBaslik}</h2>
    </div>

    <div class="row gx-0">
      {projeler.map((proje) => (
        <div class="col-lg-6">
          <a class="portfolio-item" href={proje.link ?? '#!'}>
            <div class="caption">
              <div class="caption-content">
                <div class="h2">{proje.baslik}</div>
                <p class="mb-0">{proje.aciklama}</p>
              </div>
            </div>
            <img
              class="img-fluid"
              src={proje.gorsel}
              alt={proje.baslik}
            />
          </a>
        </div>
      ))}
    </div>

  </div>
</section>