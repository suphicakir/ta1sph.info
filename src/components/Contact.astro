---
// src/components/Contact.astro
interface Props {
  haritaUrl?: string;
  haritaBaslik?: string;
}

const {
  haritaUrl = '<iframe src="https://www.google.com/maps/embed?pb=!1m14!1m12!1m3!1d8028.655482740629!2d28.91396773978922!3d41.083247110120276!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!5e0!3m2!1str!2str!4v1780309182636!5m2!1str!2str" width="600" height="450" style="border:0;" allowfullscreen="" loading="lazy" referrerpolicy="no-referrer-when-downgrade"></iframe>',
  haritaBaslik = 'QTH',
} = Astro.props;
---

<div class="map" id="contact">
  <iframe
    src={haritaUrl}
    title={haritaBaslik}
    width="100%"
    height="100%"
    style="border: 0;"
    allowfullscreen
    loading="lazy"
    referrerpolicy="no-referrer-when-downgrade"
  ></iframe>
</div>